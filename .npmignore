# Exclude development and configuration files from npm package

# Version control
.git/
.gitignore

# Development configuration
.github/
.vscode/

# Development files
example/
test/
*.test.js
.babelrc
jest.config.cjs
.eslintrc.cjs
rollup.config.js

# Node modules and logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
coverage/
.nyc_output/

# IDE and editor files
.DS_Store
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini